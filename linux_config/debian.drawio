        </mxCell>
        <mxCell id="eQcsKB0TUFDLTDkjZkjE-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=50;" value="i3wm 指定软件打开的工作区" vertex="1">
