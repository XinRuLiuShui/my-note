        <mxCell id="eQcsKB0TUFDLTDkjZkjE-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="1370" width="1150" x="-110" y="9630" as="geometry" />
        </mxCell>
        <mxCell id="eQcsKB0TUFDLTDkjZkjE-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=50;" value="emacs 中 magit使用方法" vertex="1">
          <mxGeometry height="90" width="777.5" x="73" y="9670" as="geometry" />
        </mxCell>
        <mxCell id="eQcsKB0TUFDLTDkjZkjE-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=50;" value="1、&lt;span class=&quot;&quot;&gt;在 Emacs 里按 &lt;/span&gt;&lt;code&gt;C-x g&lt;/code&gt;&lt;span class=&quot;&quot;&gt;,就会打开当前 Git 仓库的&lt;/span&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;状态缓冲区&lt;/span&gt;&lt;/strong&gt;&lt;span class=&quot;&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="850" x="60" y="9800" as="geometry" />
        </mxCell>
        <mxCell id="eQcsKB0TUFDLTDkjZkjE-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=50;" value="&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;查看改动&lt;/span&gt;&lt;/strong&gt;&lt;span class=&quot;&quot;&gt;：把光标移到某个文件上，按 &lt;/span&gt;&lt;code&gt;TAB&lt;/code&gt;&lt;span class=&quot;&quot;&gt; 可以展开/折叠，看看这个文件里具体改了哪些内容&lt;/span&gt;&lt;span class=&quot;&quot;&gt;。&lt;/span&gt;&lt;span class=&quot;&quot;&gt;。&lt;/span&gt;&lt;/font&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;暂存改动（Stage）&lt;/span&gt;&lt;/strong&gt;&lt;span class=&quot;&quot;&gt;：确认改动没问题后，按 &lt;/span&gt;&lt;code&gt;s&lt;/code&gt;&lt;span class=&quot;&quot;&gt; 就会把当前光标所在的那一行（可以是整个文件，也可以是一个代码块）暂存起来。被暂存的内容会出现在 “Staged changes” 区域。&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;取消暂存（Unstage）&lt;/span&gt;&lt;/strong&gt;&lt;span class=&quot;&quot;&gt;：如果暂存错了，把光标移到 “Staged changes” 区域里的改动上，按 &lt;/span&gt;&lt;code&gt;u&lt;/code&gt;&lt;span class=&quot;&quot;&gt; 可以撤销暂存。&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;提交（Commit）&lt;/span&gt;&lt;/strong&gt;&lt;span class=&quot;&quot;&gt;：当你把所有想提交的改动都暂存好之后，按 &lt;/span&gt;&lt;code&gt;c&lt;/code&gt;&lt;span class=&quot;&quot;&gt;。此时 Magit 会在底部弹出一个菜单，你&lt;/span&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;再按一次 &lt;/span&gt;&lt;code&gt;c&lt;/code&gt;&lt;/strong&gt;&lt;span class=&quot;&quot;&gt;，就会打开提交信息编辑缓冲区。&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;完成提交&lt;/span&gt;&lt;/strong&gt;&lt;span class=&quot;&quot;&gt;：在提交信息缓冲区里写好日志，然后按 &lt;/span&gt;&lt;code&gt;C-c C-c&lt;/code&gt;&lt;span class=&quot;&quot;&gt;，提交就完成了&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="1010" width="1040" x="-47.5" y="9940" as="geometry" />
        </mxCell>
