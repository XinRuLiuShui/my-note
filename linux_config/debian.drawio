        <mxCell id="nwbDJeJoBWh_e4vlS9ry-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=50;" value="v2rayn" vertex="1">
