        <mxCell id="eQcsKB0TUFDLTDkjZkjE-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=50;" value="cien@debian:~$ xprop | grep WM_CLASS&lt;br&gt;WM_CLASS(STRING) = &quot;v2rayN&quot;, &quot;v2rayN&quot;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
